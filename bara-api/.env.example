MONGODB_URI=mongodb://bara_app:APP_PASSWORD@mongo:27017/bara?authSource=bara
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=bara-media
S3_ACCESS_KEY=replace-with-storage-access-key
S3_SECRET_KEY=replace-with-storage-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Snapshot criteria, capture quality, and legacy flame analysis.
OPENAI_IMAGE_MODEL=gpt-6-luna
# Optional separate model for session follow-up questions; defaults to OPENAI_MODEL.
OPENAI_INSTRUCTION_MODEL=
